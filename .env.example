# Copy to .env and fill in real values. .env is gitignored — never commit it.

# Discovery path only (app/agent). Replay must work with this unset.
ANTHROPIC_API_KEY=

# Mock bank target. No trailing slash.
BANK_BASE_URL=http://127.0.0.1:8000
BANK_USERNAME=demo
BANK_PASSWORD=demo1234

# Comma-separated, exact scheme://host:port match. No wildcards.
ALLOWED_ORIGINS=http://127.0.0.1:8000
