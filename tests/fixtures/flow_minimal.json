{
  "schema_version": 1,
  "id": "flow_minimal",
  "title": "Minimal 3-step flow for engine unit tests",
  "origin": "http://127.0.0.1:8000",
  "created_at": "2026-08-17T00:00:00Z",
  "created_by": {
    "mode": "manual",
    "run_id": "fixture"
  },
  "bindings": [],
  "outputs": [
    "heading_text"
  ],
  "steps": [
    {
      "id": "goto_login",
      "kind": "goto",
      "description": "Open the login page",
      "url": "/login.html",
      "budget_ms": 5000,
      "on_fail": "abort",
      "locators": []
    },
    {
      "id": "wait_for_form",
      "kind": "wait_for",
      "description": "Wait for the login form to render",
      "budget_ms": 3000,
      "on_fail": "abort",
      "locators": [
        {
          "strategy": "testid",
          "value": "login-form"
        }
      ]
    },
    {
      "id": "read_heading",
      "kind": "extract",
      "description": "Read the page heading",
      "output": "heading_text",
      "budget_ms": 3000,
      "on_fail": "abort",
      "locators": [
        {
          "strategy": "role_name",
          "value": "Log in",
          "role": "heading"
        },
        {
          "strategy": "text",
          "value": "Log in"
        }
      ]
    }
  ]
}
